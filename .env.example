# Kopiere diese Datei nach ".env" und trage deine Werte ein. Keine echten Schlüssel in dieser Datei!

# Datenbankdatei (außerhalb von Cloud-Sync-Ordnern ablegen)
DB_PATH=

# Nur lokal: 1 = Standortprüfung überspringen. In Produktion leer lassen oder 0.
DEV_SKIP_LOCATION=0

# demo = Beispieldaten | DB-Timetables-Echtzeit wird mit den Schlüsseln aktiviert
DATA_SOURCE=demo
DB_TIMETABLES_CLIENT_ID=
DB_TIMETABLES_API_KEY=

# demo = Test-Premium ohne Geld | play = Google Play Billing (siehe README)
PAYMENTS_MODE=demo

# Erster Admin beim Ausführen von db/init.php
ADMIN_EMAIL=admin@traintrust.local
ADMIN_PASSWORD=

# Kommagetrennt: Web-Herkünfte, die die API aufrufen dürfen (APK: capacitor://localhost, https://localhost)
ALLOWED_ORIGINS=http://localhost,https://localhost,capacitor://localhost
